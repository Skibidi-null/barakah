[[1," قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ","Say, \"I seek refuge in the Lord of mankind,","Qul aAAoothu birabbi annas",604,30,0],[2,"مَلِكِ ٱلنَّاسِ","The Sovereign of mankind,","Maliki annas",604,30,0],[3,"إِلَـٰهِ ٱلنَّاسِ","The God of mankind,","Ilahi annas",604,30,0],[4,"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ","From the evil of the retreating whisperer -","Min sharri alwaswasi alkhannas",604,30,0],[5,"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ","Who whispers [evil] into the breasts of mankind -","Allathee yuwaswisu fee sudoori annas",604,30,0],[6,"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ","From among the jinn and mankind\".","Mina aljinnati wannas",604,30,0]]