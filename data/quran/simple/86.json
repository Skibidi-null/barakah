[["وَالسَّمَاءِ وَالطَّارِقِ",14],["وَمَا أَدْرَاكَ مَا الطَّارِقُ",16],["النَّجْمُ الثَّاقِبُ",11],["إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ",19],["فَلْيَنظُرِ الْإِنسَانُ مِمَّ خُلِقَ",17],["خُلِقَ مِن مَّاءٍ دَافِقٍ",12],["يَخْرُجُ مِن بَيْنِ الصُّلْبِ وَالتَّرَائِبِ",22],["إِنَّهُ عَلَىٰ رَجْعِهِ لَقَادِرٌ",15],["يَوْمَ تُبْلَى السَّرَائِرُ",14],["فَمَا لَهُ مِن قُوَّةٍ وَلَا نَاصِرٍ",17],["وَالسَّمَاءِ ذَاتِ الرَّجْعِ",15],["وَالْأَرْضِ ذَاتِ الصَّدْعِ",14],["إِنَّهُ لَقَوْلٌ فَصْلٌ",10],["وَمَا هُوَ بِالْهَزْلِ",11],["إِنَّهُمْ يَكِيدُونَ كَيْدًا",14],["وَأَكِيدُ كَيْدًا",9],["فَمَهِّلِ الْكَافِرِينَ أَمْهِلْهُمْ رُوَيْدًا",22]]