[["لَا أُقْسِمُ بِيَوْمِ الْقِيَامَةِ",16],["وَلَا أُقْسِمُ بِالنَّفْسِ اللَّوَّامَةِ",20],["أَيَحْسَبُ الْإِنسَانُ أَلَّن نَّجْمَعَ عِظَامَهُ",23],["بَلَىٰ قَادِرِينَ عَلَىٰ أَن نُّسَوِّيَ بَنَانَهُ",22],["بَلْ يُرِيدُ الْإِنسَانُ لِيَفْجُرَ أَمَامَهُ",22],["يَسْأَلُ أَيَّانَ يَوْمُ الْقِيَامَةِ",16],["فَإِذَا بَرِقَ الْبَصَرُ",12],["وَخَسَفَ الْقَمَرُ",9],["وَجُمِعَ الشَّمْسُ وَالْقَمَرُ",15],["يَقُولُ الْإِنسَانُ يَوْمَئِذٍ أَيْنَ الْمَفَرُّ",23],["كَلَّا لَا وَزَرَ",8],["إِلَىٰ رَبِّكَ يَوْمَئِذٍ الْمُسْتَقَرُّ",18],["يُنَبَّأُ الْإِنسَانُ يَوْمَئِذٍ بِمَا قَدَّمَ وَأَخَّرَ",26],["بَلِ الْإِنسَانُ عَلَىٰ نَفْسِهِ بَصِيرَةٌ",20],["وَلَوْ أَلْقَىٰ مَعَاذِيرَهُ",14],["لَا تُحَرِّكْ بِهِ لِسَانَكَ لِتَعْجَلَ بِهِ",20],["إِنَّ عَلَيْنَا جَمْعَهُ وَقُرْآنَهُ",18],["فَإِذَا قَرَأْنَاهُ فَاتَّبِعْ قُرْآنَهُ",20],["ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُ",14],["كَلَّا بَلْ تُحِبُّونَ الْعَاجِلَةَ",17],["وَتَذَرُونَ الْآخِرَةَ",12],["وُجُوهٌ يَوْمَئِذٍ نَّاضِرَةٌ",14],["إِلَىٰ رَبِّهَا نَاظِرَةٌ",12],["وَوُجُوهٌ يَوْمَئِذٍ بَاسِرَةٌ",15],["تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌ",17],["كَلَّا إِذَا بَلَغَتِ التَّرَاقِيَ",17],["وَقِيلَ مَنْ رَاقٍ",9],["وَظَنَّ أَنَّهُ الْفِرَاقُ",12],["وَالْتَفَّتِ السَّاقُ بِالسَّاقِ",17],["إِلَىٰ رَبِّكَ يَوْمَئِذٍ الْمَسَاقُ",17],["فَلَا صَدَّقَ وَلَا صَلَّىٰ",12],["وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ",12],["ثُمَّ ذَهَبَ إِلَىٰ أَهْلِهِ يَتَمَطَّىٰ",17],["أَوْلَىٰ لَكَ فَأَوْلَىٰ",11],["ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰ",13],["أَيَحْسَبُ الْإِنسَانُ أَن يُتْرَكَ سُدًى",20],["أَلَمْ يَكُ نُطْفَةً مِّن مَّنِيٍّ يُمْنَىٰ",18],["ثُمَّ كَانَ عَلَقَةً فَخَلَقَ فَسَوَّىٰ",17],["فَجَعَلَ مِنْهُ الزَّوْجَيْنِ الذَّكَرَ وَالْأُنثَىٰ",26],["أَلَيْسَ ذَٰلِكَ بِقَادِرٍ عَلَىٰ أَن يُحْيِيَ الْمَوْتَىٰ",25]]