[["بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ",19],["الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ",17],["الرَّحْمَٰنِ الرَّحِيمِ",12],["مَالِكِ يَوْمِ الدِّينِ",11],["إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ",19],["اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ",18],["صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّالِّينَ",43]]