[["عَبَسَ وَتَوَلَّىٰ",8],["أَن جَاءَهُ الْأَعْمَىٰ",12],["وَمَا يُدْرِيكَ لَعَلَّهُ يَزَّكَّىٰ",16],["أَوْ يَذَّكَّرُ فَتَنفَعَهُ الذِّكْرَىٰ",18],["أَمَّا مَنِ اسْتَغْنَىٰ",11],["فَأَنتَ لَهُ تَصَدَّىٰ",10],["وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ",14],["وَأَمَّا مَن جَاءَكَ يَسْعَىٰ",14],["وَهُوَ يَخْشَىٰ",7],["فَأَنتَ عَنْهُ تَلَهَّىٰ",11],["كَلَّا إِنَّهَا تَذْكِرَةٌ",12],["فَمَن شَاءَ ذَكَرَهُ",10],["فِي صُحُفٍ مُّكَرَّمَةٍ",10],["مَّرْفُوعَةٍ مُّطَهَّرَةٍ",11],["بِأَيْدِي سَفَرَةٍ",9],["كِرَامٍ بَرَرَةٍ",8],["قُتِلَ الْإِنسَانُ مَا أَكْفَرَهُ",16],["مِنْ أَيِّ شَيْءٍ خَلَقَهُ",11],["مِن نُّطْفَةٍ خَلَقَهُ فَقَدَّرَهُ",15],["ثُمَّ السَّبِيلَ يَسَّرَهُ",12],["ثُمَّ أَمَاتَهُ فَأَقْبَرَهُ",13],["ثُمَّ إِذَا شَاءَ أَنشَرَهُ",13],["كَلَّا لَمَّا يَقْضِ مَا أَمَرَهُ",15],["فَلْيَنظُرِ الْإِنسَانُ إِلَىٰ طَعَامِهِ",20],["أَنَّا صَبَبْنَا الْمَاءَ صَبًّا",16],["ثُمَّ شَقَقْنَا الْأَرْضَ شَقًّا",15],["فَأَنبَتْنَا فِيهَا حَبًّا",14],["وَعِنَبًا وَقَضْبًا",10],["وَزَيْتُونًا وَنَخْلًا",12],["وَحَدَائِقَ غُلْبًا",10],["وَفَاكِهَةً وَأَبًّا",9],["مَّتَاعًا لَّكُمْ وَلِأَنْعَامِكُمْ",15],["فَإِذَا جَاءَتِ الصَّاخَّةُ",14],["يَوْمَ يَفِرُّ الْمَرْءُ مِنْ أَخِيهِ",17],["وَأُمِّهِ وَأَبِيهِ",9],["وَصَاحِبَتِهِ وَبَنِيهِ",11],["لِكُلِّ امْرِئٍ مِّنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْنِيهِ",24],["وُجُوهٌ يَوْمَئِذٍ مُّسْفِرَةٌ",14],["ضَاحِكَةٌ مُّسْتَبْشِرَةٌ",12],["وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ",19],["تَرْهَقُهَا قَتَرَةٌ",10],["أُولَٰئِكَ هُمُ الْكَفَرَةُ الْفَجَرَةُ",19]]