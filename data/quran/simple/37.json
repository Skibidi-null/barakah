[["وَالصَّافَّاتِ صَفًّا",9],["فَالزَّاجِرَاتِ زَجْرًا",11],["فَالتَّالِيَاتِ ذِكْرًا",11],["إِنَّ إِلَٰهَكُمْ لَوَاحِدٌ",11],["رَّبُّ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ الْمَشَارِقِ",32],["إِنَّا زَيَّنَّا السَّمَاءَ الدُّنْيَا بِزِينَةٍ الْكَوَاكِبِ",31],["وَحِفْظًا مِّن كُلِّ شَيْطَانٍ مَّارِدٍ",17],["لَّا يَسَّمَّعُونَ إِلَى الْمَلَإِ الْأَعْلَىٰ وَيُقْذَفُونَ مِن كُلِّ جَانِبٍ",37],["دُحُورًا وَلَهُمْ عَذَابٌ وَاصِبٌ",17],["إِلَّا مَنْ خَطِفَ الْخَطْفَةَ فَأَتْبَعَهُ شِهَابٌ ثَاقِبٌ",28],["فَاسْتَفْتِهِمْ أَهُمْ أَشَدُّ خَلْقًا أَم مَّنْ خَلَقْنَا إِنَّا خَلَقْنَاهُم مِّن طِينٍ لَّازِبٍ",45],["بَلْ عَجِبْتَ وَيَسْخَرُونَ",13],["وَإِذَا ذُكِّرُوا لَا يَذْكُرُونَ",17],["وَإِذَا رَأَوْا آيَةً يَسْتَسْخِرُونَ",20],["وَقَالُوا إِنْ هَٰذَا إِلَّا سِحْرٌ مُّبِينٌ",21],["أَإِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَامًا أَإِنَّا لَمَبْعُوثُونَ",34],["أَوَآبَاؤُنَا الْأَوَّلُونَ",16],["قُلْ نَعَمْ وَأَنتُمْ دَاخِرُونَ",15],["فَإِنَّمَا هِيَ زَجْرَةٌ وَاحِدَةٌ فَإِذَا هُمْ يَنظُرُونَ",27],["وَقَالُوا يَا وَيْلَنَا هَٰذَا يَوْمُ الدِّينِ",23],["هَٰذَا يَوْمُ الْفَصْلِ الَّذِي كُنتُم بِهِ تُكَذِّبُونَ",27],["احْشُرُوا الَّذِينَ ظَلَمُوا وَأَزْوَاجَهُمْ وَمَا كَانُوا يَعْبُدُونَ",37],["مِن دُونِ اللَّهِ فَاهْدُوهُمْ إِلَىٰ صِرَاطِ الْجَحِيمِ",28],["وَقِفُوهُمْ إِنَّهُم مَّسْئُولُونَ",16],["مَا لَكُمْ لَا تَنَاصَرُونَ",14],["بَلْ هُمُ الْيَوْمَ مُسْتَسْلِمُونَ",17],["وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَاءَلُونَ",24],["قَالُوا إِنَّكُمْ كُنتُمْ تَأْتُونَنَا عَنِ الْيَمِينِ",28],["قَالُوا بَل لَّمْ تَكُونُوا مُؤْمِنِينَ",21],["وَمَا كَانَ لَنَا عَلَيْكُم مِّن سُلْطَانٍ بَلْ كُنتُمْ قَوْمًا طَاغِينَ",34],["فَحَقَّ عَلَيْنَا قَوْلُ رَبِّنَا إِنَّا لَذَائِقُونَ",25],["فَأَغْوَيْنَاكُمْ إِنَّا كُنَّا غَاوِينَ",18],["فَإِنَّهُمْ يَوْمَئِذٍ فِي الْعَذَابِ مُشْتَرِكُونَ",25],["إِنَّا كَذَٰلِكَ نَفْعَلُ بِالْمُجْرِمِينَ",20],["إِنَّهُمْ كَانُوا إِذَا قِيلَ لَهُمْ لَا إِلَٰهَ إِلَّا اللَّهُ يَسْتَكْبِرُونَ",38],["وَيَقُولُونَ أَئِنَّا لَتَارِكُو آلِهَتِنَا لِشَاعِرٍ مَّجْنُونٍ",35],["بَلْ جَاءَ بِالْحَقِّ وَصَدَّقَ الْمُرْسَلِينَ",22],["إِنَّكُمْ لَذَائِقُو الْعَذَابِ الْأَلِيمِ",23],["وَمَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ",23],["إِلَّا عِبَادَ اللَّهِ الْمُخْلَصِينَ",19],["أُولَٰئِكَ لَهُمْ رِزْقٌ مَّعْلُومٌ",16],["فَوَاكِهُ وَهُم مُّكْرَمُونَ",13],["فِي جَنَّاتِ النَّعِيمِ",11],["عَلَىٰ سُرُرٍ مُّتَقَابِلِينَ",13],["يُطَافُ عَلَيْهِم بِكَأْسٍ مِّن مَّعِينٍ",19],["بَيْضَاءَ لَذَّةٍ لِّلشَّارِبِينَ",15],["لَا فِيهَا غَوْلٌ وَلَا هُمْ عَنْهَا يُنزَفُونَ",24],["وَعِندَهُمْ قَاصِرَاتُ الطَّرْفِ عِينٌ",18],["كَأَنَّهُنَّ بَيْضٌ مَّكْنُونٌ",13],["فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَاءَلُونَ",24],["قَالَ قَائِلٌ مِّنْهُمْ إِنِّي كَانَ لِي قَرِينٌ",23],["يَقُولُ أَإِنَّكَ لَمِنَ الْمُصَدِّقِينَ",19],["أَإِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَامًا أَإِنَّا لَمَدِينُونَ",33],["قَالَ هَلْ أَنتُم مُّطَّلِعُونَ",15],["فَاطَّلَعَ فَرَآهُ فِي سَوَاءِ الْجَحِيمِ",22],["قَالَ تَاللَّهِ إِن كِدتَّ لَتُرْدِينِ",19],["وَلَوْلَا نِعْمَةُ رَبِّي لَكُنتُ مِنَ الْمُحْضَرِينَ",26],["أَفَمَا نَحْنُ بِمَيِّتِينَ",13],["إِلَّا مَوْتَتَنَا الْأُولَىٰ وَمَا نَحْنُ بِمُعَذَّبِينَ",28],["إِنَّ هَٰذَا لَهُوَ الْفَوْزُ الْعَظِيمُ",19],["لِمِثْلِ هَٰذَا فَلْيَعْمَلِ الْعَامِلُونَ",20],["أَذَٰلِكَ خَيْرٌ نُّزُلًا أَمْ شَجَرَةُ الزَّقُّومِ",23],["إِنَّا جَعَلْنَاهَا فِتْنَةً لِّلظَّالِمِينَ",20],["إِنَّهَا شَجَرَةٌ تَخْرُجُ فِي أَصْلِ الْجَحِيمِ",23],["طَلْعُهَا كَأَنَّهُ رُءُوسُ الشَّيَاطِينِ",20],["فَإِنَّهُمْ لَآكِلُونَ مِنْهَا فَمَالِئُونَ مِنْهَا الْبُطُونَ",31],["ثُمَّ إِنَّ لَهُمْ عَلَيْهَا لَشَوْبًا مِّنْ حَمِيمٍ",23],["ثُمَّ إِنَّ مَرْجِعَهُمْ لَإِلَى الْجَحِيمِ",20],["إِنَّهُمْ أَلْفَوْا آبَاءَهُمْ ضَالِّينَ",21],["فَهُمْ عَلَىٰ آثَارِهِمْ يُهْرَعُونَ",18],["وَلَقَدْ ضَلَّ قَبْلَهُمْ أَكْثَرُ الْأَوَّلِينَ",22],["وَلَقَدْ أَرْسَلْنَا فِيهِم مُّنذِرِينَ",20],["فَانظُرْ كَيْفَ كَانَ عَاقِبَةُ الْمُنذَرِينَ",23],["إِلَّا عِبَادَ اللَّهِ الْمُخْلَصِينَ",19],["وَلَقَدْ نَادَانَا نُوحٌ فَلَنِعْمَ الْمُجِيبُونَ",26],["وَنَجَّيْنَاهُ وَأَهْلَهُ مِنَ الْكَرْبِ الْعَظِيمِ",24],["وَجَعَلْنَا ذُرِّيَّتَهُ هُمُ الْبَاقِينَ",20],["وَتَرَكْنَا عَلَيْهِ فِي الْآخِرِينَ",19],["سَلَامٌ عَلَىٰ نُوحٍ فِي الْعَالَمِينَ",18],["إِنَّا كَذَٰلِكَ نَجْزِي الْمُحْسِنِينَ",19],["إِنَّهُ مِنْ عِبَادِنَا الْمُؤْمِنِينَ",19],["ثُمَّ أَغْرَقْنَا الْآخَرِينَ",15],["وَإِنَّ مِن شِيعَتِهِ لَإِبْرَاهِيمَ",17],["إِذْ جَاءَ رَبَّهُ بِقَلْبٍ سَلِيمٍ",16],["إِذْ قَالَ لِأَبِيهِ وَقَوْمِهِ مَاذَا تَعْبُدُونَ",25],["أَئِفْكًا آلِهَةً دُونَ اللَّهِ تُرِيدُونَ",23],["فَمَا ظَنُّكُم بِرَبِّ الْعَالَمِينَ",17],["فَنَظَرَ نَظْرَةً فِي النُّجُومِ",16],["فَقَالَ إِنِّي سَقِيمٌ",11],["فَتَوَلَّوْا عَنْهُ مُدْبِرِينَ",15],["فَرَاغَ إِلَىٰ آلِهَتِهِمْ فَقَالَ أَلَا تَأْكُلُونَ",27],["مَا لَكُمْ لَا تَنطِقُونَ",13],["فَرَاغَ عَلَيْهِمْ ضَرْبًا بِالْيَمِينِ",20],["فَأَقْبَلُوا إِلَيْهِ يَزِفُّونَ",16],["قَالَ أَتَعْبُدُونَ مَا تَنْحِتُونَ",18],["وَاللَّهُ خَلَقَكُمْ وَمَا تَعْمَلُونَ",19],["قَالُوا ابْنُوا لَهُ بُنْيَانًا فَأَلْقُوهُ فِي الْجَحِيمِ",31],["فَأَرَادُوا بِهِ كَيْدًا فَجَعَلْنَاهُمُ الْأَسْفَلِينَ",28],["وَقَالَ إِنِّي ذَاهِبٌ إِلَىٰ رَبِّي سَيَهْدِينِ",23],["رَبِّ هَبْ لِي مِنَ الصَّالِحِينَ",15],["فَبَشَّرْنَاهُ بِغُلَامٍ حَلِيمٍ",14],["فَلَمَّا بَلَغَ مَعَهُ السَّعْيَ قَالَ يَا بُنَيَّ إِنِّي أَرَىٰ فِي الْمَنَامِ أَنِّي أَذْبَحُكَ فَانظُرْ مَاذَا تَرَىٰ قَالَ يَا أَبَتِ افْعَلْ مَا تُؤْمَرُ سَتَجِدُنِي إِن شَاءَ اللَّهُ مِنَ الصَّابِرِينَ",97],["فَلَمَّا أَسْلَمَا وَتَلَّهُ لِلْجَبِينِ",19],["وَنَادَيْنَاهُ أَن يَا إِبْرَاهِيمُ",15],["قَدْ صَدَّقْتَ الرُّؤْيَا إِنَّا كَذَٰلِكَ نَجْزِي الْمُحْسِنِينَ",31],["إِنَّ هَٰذَا لَهُوَ الْبَلَاءُ الْمُبِينُ",20],["وَفَدَيْنَاهُ بِذِبْحٍ عَظِيمٍ",14],["وَتَرَكْنَا عَلَيْهِ فِي الْآخِرِينَ",19],["سَلَامٌ عَلَىٰ إِبْرَاهِيمَ",12],["كَذَٰلِكَ نَجْزِي الْمُحْسِنِينَ",16],["إِنَّهُ مِنْ عِبَادِنَا الْمُؤْمِنِينَ",19],["وَبَشَّرْنَاهُ بِإِسْحَاقَ نَبِيًّا مِّنَ الصَّالِحِينَ",24],["وَبَارَكْنَا عَلَيْهِ وَعَلَىٰ إِسْحَاقَ وَمِن ذُرِّيَّتِهِمَا مُحْسِنٌ وَظَالِمٌ لِّنَفْسِهِ مُبِينٌ",46],["وَلَقَدْ مَنَنَّا عَلَىٰ مُوسَىٰ وَهَارُونَ",20],["وَنَجَّيْنَاهُمَا وَقَوْمَهُمَا مِنَ الْكَرْبِ الْعَظِيمِ",28],["وَنَصَرْنَاهُمْ فَكَانُوا هُمُ الْغَالِبِينَ",22],["وَآتَيْنَاهُمَا الْكِتَابَ الْمُسْتَبِينَ",22],["وَهَدَيْنَاهُمَا الصِّرَاطَ الْمُسْتَقِيمَ",21],["وَتَرَكْنَا عَلَيْهِمَا فِي الْآخِرِينَ",21],["سَلَامٌ عَلَىٰ مُوسَىٰ وَهَارُونَ",15],["إِنَّا كَذَٰلِكَ نَجْزِي الْمُحْسِنِينَ",19],["إِنَّهُمَا مِنْ عِبَادِنَا الْمُؤْمِنِينَ",21],["وَإِنَّ إِلْيَاسَ لَمِنَ الْمُرْسَلِينَ",19],["إِذْ قَالَ لِقَوْمِهِ أَلَا تَتَّقُونَ",18],["أَتَدْعُونَ بَعْلًا وَتَذَرُونَ أَحْسَنَ الْخَالِقِينَ",27],["اللَّهَ رَبَّكُمْ وَرَبَّ آبَائِكُمُ الْأَوَّلِينَ",25],["فَكَذَّبُوهُ فَإِنَّهُمْ لَمُحْضَرُونَ",18],["إِلَّا عِبَادَ اللَّهِ الْمُخْلَصِينَ",19],["وَتَرَكْنَا عَلَيْهِ فِي الْآخِرِينَ",19],["سَلَامٌ عَلَىٰ إِلْ يَاسِينَ",13],["إِنَّا كَذَٰلِكَ نَجْزِي الْمُحْسِنِينَ",19],["إِنَّهُ مِنْ عِبَادِنَا الْمُؤْمِنِينَ",19],["وَإِنَّ لُوطًا لَّمِنَ الْمُرْسَلِينَ",18],["إِذْ نَجَّيْنَاهُ وَأَهْلَهُ أَجْمَعِينَ",18],["إِلَّا عَجُوزًا فِي الْغَابِرِينَ",17],["ثُمَّ دَمَّرْنَا الْآخَرِينَ",14],["وَإِنَّكُمْ لَتَمُرُّونَ عَلَيْهِم مُّصْبِحِينَ",22],["وَبِاللَّيْلِ أَفَلَا تَعْقِلُونَ",16],["وَإِنَّ يُونُسَ لَمِنَ الْمُرْسَلِينَ",18],["إِذْ أَبَقَ إِلَى الْفُلْكِ الْمَشْحُونِ",20],["فَسَاهَمَ فَكَانَ مِنَ الْمُدْحَضِينَ",19],["فَالْتَقَمَهُ الْحُوتُ وَهُوَ مُلِيمٌ",19],["فَلَوْلَا أَنَّهُ كَانَ مِنَ الْمُسَبِّحِينَ",21],["لَلَبِثَ فِي بَطْنِهِ إِلَىٰ يَوْمِ يُبْعَثُونَ",22],["فَنَبَذْنَاهُ بِالْعَرَاءِ وَهُوَ سَقِيمٌ",20],["وَأَنبَتْنَا عَلَيْهِ شَجَرَةً مِّن يَقْطِينٍ",22],["وَأَرْسَلْنَاهُ إِلَىٰ مِائَةِ أَلْفٍ أَوْ يَزِيدُونَ",25],["فَآمَنُوا فَمَتَّعْنَاهُمْ إِلَىٰ حِينٍ",19],["فَاسْتَفْتِهِمْ أَلِرَبِّكَ الْبَنَاتُ وَلَهُمُ الْبَنُونَ",29],["أَمْ خَلَقْنَا الْمَلَائِكَةَ إِنَاثًا وَهُمْ شَاهِدُونَ",26],["أَلَا إِنَّهُم مِّنْ إِفْكِهِمْ لَيَقُولُونَ",21],["وَلَدَ اللَّهُ وَإِنَّهُمْ لَكَاذِبُونَ",18],["أَصْطَفَى الْبَنَاتِ عَلَى الْبَنِينَ",20],["مَا لَكُمْ كَيْفَ تَحْكُمُونَ",14],["أَفَلَا ت