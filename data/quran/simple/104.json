[["وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ",14],["الَّذِي جَمَعَ مَالًا وَعَدَّدَهُ",16],["يَحْسَبُ أَنَّ مَالَهُ أَخْلَدَهُ",15],["كَلَّا ۖ لَيُنبَذَنَّ فِي الْحُطَمَةِ",17],["وَمَا أَدْرَاكَ مَا الْحُطَمَةُ",16],["نَارُ اللَّهِ الْمُوقَدَةُ",14],["الَّتِي تَطَّلِعُ عَلَى الْأَفْئِدَةِ",17],["إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌ",14],["فِي عَمَدٍ مُّمَدَّدَةٍ",10]]