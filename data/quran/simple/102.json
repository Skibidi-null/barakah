[["أَلْهَاكُمُ التَّكَاثُرُ",13],["حَتَّىٰ زُرْتُمُ الْمَقَابِرَ",14],["كَلَّا سَوْفَ تَعْلَمُونَ",12],["ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ",14],["كَلَّا لَوْ تَعْلَمُونَ عِلْمَ الْيَقِينِ",20],["لَتَرَوُنَّ الْجَحِيمَ",11],["ثُمَّ لَتَرَوُنَّهَا عَيْنَ الْيَقِينِ",18],["ثُمَّ لَتُسْأَلُنَّ يَوْمَئِذٍ عَنِ النَّعِيمِ",20]]