[["هَلْ أَتَاكَ حَدِيثُ الْغَاشِيَةِ",16],["وُجُوهٌ يَوْمَئِذٍ خَاشِعَةٌ",13],["عَامِلَةٌ نَّاصِبَةٌ",10],["تَصْلَىٰ نَارًا حَامِيَةً",13],["تُسْقَىٰ مِنْ عَيْنٍ آنِيَةٍ",14],["لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍ",19],["لَّا يُسْمِنُ وَلَا يُغْنِي مِن جُوعٍ",18],["وُجُوهٌ يَوْمَئِذٍ نَّاعِمَةٌ",14],["لِّسَعْيِهَا رَاضِيَةٌ",11],["فِي جَنَّةٍ عَالِيَةٍ",10],["لَّا تَسْمَعُ فِيهَا لَاغِيَةً",14],["فِيهَا عَيْنٌ جَارِيَةٌ",12],["فِيهَا سُرُرٌ مَّرْفُوعَةٌ",13],["وَأَكْوَابٌ مَّوْضُوعَةٌ",12],["وَنَمَارِقُ مَصْفُوفَةٌ",12],["وَزَرَابِيُّ مَبْثُوثَةٌ",12],["أَفَلَا يَنظُرُونَ إِلَى الْإِبِلِ كَيْفَ خُلِقَتْ",25],["وَإِلَى السَّمَاءِ كَيْفَ رُفِعَتْ",17],["وَإِلَى الْجِبَالِ كَيْفَ نُصِبَتْ",17],["وَإِلَى الْأَرْضِ كَيْفَ سُطِحَتْ",16],["فَذَكِّرْ إِنَّمَا أَنتَ مُذَكِّرٌ",15],["لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ",14],["إِلَّا مَن تَوَلَّىٰ وَكَفَرَ",13],["فَيُعَذِّبُهُ اللَّهُ الْعَذَابَ الْأَكْبَرَ",22],["إِنَّ إِلَيْنَا إِيَابَهُمْ",13],["ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم",15]]