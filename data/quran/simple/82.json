[["إِذَا السَّمَاءُ انفَطَرَتْ",15],["وَإِذَا الْكَوَاكِبُ انتَثَرَتْ",17],["وَإِذَا الْبِحَارُ فُجِّرَتْ",14],["وَإِذَا الْقُبُورُ بُعْثِرَتْ",15],["عَلِمَتْ نَفْسٌ مَّا قَدَّمَتْ وَأَخَّرَتْ",18],["يَا أَيُّهَا الْإِنسَانُ مَا غَرَّكَ بِرَبِّكَ الْكَرِيمِ",26],["الَّذِي خَلَقَكَ فَسَوَّاكَ فَعَدَلَكَ",18],["فِي أَيِّ صُورَةٍ مَّا شَاءَ رَكَّبَكَ",17],["كَلَّا بَلْ تُكَذِّبُونَ بِالدِّينِ",17],["وَإِنَّ عَلَيْكُمْ لَحَافِظِينَ",14],["كِرَامًا كَاتِبِينَ",10],["يَعْلَمُونَ مَا تَفْعَلُونَ",14],["إِنَّ الْأَبْرَارَ لَفِي نَعِيمٍ",16],["وَإِنَّ الْفُجَّارَ لَفِي جَحِيمٍ",16],["يَصْلَوْنَهَا يَوْمَ الدِّينِ",15],["وَمَا هُمْ عَنْهَا بِغَائِبِينَ",16],["وَمَا أَدْرَاكَ مَا يَوْمُ الدِّينِ",18],["ثُمَّ مَا أَدْرَاكَ مَا يَوْمُ الدِّينِ",19],["يَوْمَ لَا تَمْلِكُ نَفْسٌ لِّنَفْسٍ شَيْئًا ۖ وَالْأَمْرُ يَوْمَئِذٍ لِّلَّهِ",33]]