[["اقْرَأْ بِاسْمِ رَبِّكَ الَّذِي خَلَقَ",18],["خَلَقَ الْإِنسَانَ مِنْ عَلَقٍ",14],["اقْرَأْ وَرَبُّكَ الْأَكْرَمُ",14],["الَّذِي عَلَّمَ بِالْقَلَمِ",13],["عَلَّمَ الْإِنسَانَ مَا لَمْ يَعْلَمْ",17],["كَلَّا إِنَّ الْإِنسَانَ لَيَطْغَىٰ",16],["أَن رَّآهُ اسْتَغْنَىٰ",12],["إِنَّ إِلَىٰ رَبِّكَ الرُّجْعَىٰ",14],["أَرَأَيْتَ الَّذِي يَنْهَىٰ",13],["عَبْدًا إِذَا صَلَّىٰ",10],["أَرَأَيْتَ إِن كَانَ عَلَى الْهُدَىٰ",18],["أَوْ أَمَرَ بِالتَّقْوَىٰ",12],["أَرَأَيْتَ إِن كَذَّبَ وَتَوَلَّىٰ",15],["أَلَمْ يَعْلَم بِأَنَّ اللَّهَ يَرَىٰ",17],["كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًا بِالنَّاصِيَةِ",26],["نَاصِيَةٍ كَاذِبَةٍ خَاطِئَةٍ",14],["فَلْيَدْعُ نَادِيَهُ",10],["سَنَدْعُ الزَّبَانِيَةَ",12],["كَلَّا لَا تُطِعْهُ وَاسْجُدْ وَاقْتَرِب",20]]