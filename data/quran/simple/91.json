[["وَالشَّمْسِ وَضُحَاهَا",12],["وَالْقَمَرِ إِذَا تَلَاهَا",14],["وَالنَّهَارِ إِذَا جَلَّاهَا",15],["وَاللَّيْلِ إِذَا يَغْشَاهَا",14],["وَالسَّمَاءِ وَمَا بَنَاهَا",15],["وَالْأَرْضِ وَمَا طَحَاهَا",14],["وَنَفْسٍ وَمَا سَوَّاهَا",12],["فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَاهَا",20],["قَدْ أَفْلَحَ مَن زَكَّاهَا",13],["وَقَدْ خَابَ مَن دَسَّاهَا",13],["كَذَّبَتْ ثَمُودُ بِطَغْوَاهَا",15],["إِذِ انبَعَثَ أَشْقَاهَا",13],["فَقَالَ لَهُمْ رَسُولُ اللَّهِ نَاقَةَ اللَّهِ وَسُقْيَاهَا",29],["فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنبِهِمْ فَسَوَّاهَا",39],["وَلَا يَخَافُ عُقْبَاهَا",12]]