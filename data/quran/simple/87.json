[["سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى",15],["الَّذِي خَلَقَ فَسَوَّىٰ",11],["وَالَّذِي قَدَّرَ فَهَدَىٰ",12],["وَالَّذِي أَخْرَجَ الْمَرْعَىٰ",15],["فَجَعَلَهُ غُثَاءً أَحْوَىٰ",13],["سَنُقْرِئُكَ فَلَا تَنسَىٰ",13],["إِلَّا مَا شَاءَ اللَّهُ ۚ إِنَّهُ يَعْلَمُ الْجَهْرَ وَمَا يَخْفَىٰ",31],["وَنُيَسِّرُكَ لِلْيُسْرَىٰ",12],["فَذَكِّرْ إِن نَّفَعَتِ الذِّكْرَىٰ",16],["سَيَذَّكَّرُ مَن يَخْشَىٰ",11],["وَيَتَجَنَّبُهَا الْأَشْقَى",14],["الَّذِي يَصْلَى النَّارَ الْكُبْرَىٰ",19],["ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ",19],["قَدْ أَفْلَحَ مَن تَزَكَّىٰ",12],["وَذَكَرَ اسْمَ رَبِّهِ فَصَلَّىٰ",14],["بَلْ تُؤْثِرُونَ الْحَيَاةَ الدُّنْيَا",20],["وَالْآخِرَةُ خَيْرٌ وَأَبْقَىٰ",15],["إِنَّ هَٰذَا لَفِي الصُّحُفِ الْأُولَىٰ",19],["صُحُفِ إِبْرَاهِيمَ وَمُوسَىٰ",14]]