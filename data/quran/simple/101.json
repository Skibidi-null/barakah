[["الْقَارِعَةُ",7],["مَا الْقَارِعَةُ",9],["وَمَا أَدْرَاكَ مَا الْقَارِعَةُ",17],["يَوْمَ يَكُونُ النَّاسُ كَالْفَرَاشِ الْمَبْثُوثِ",26],["وَتَكُونُ الْجِبَالُ كَالْعِهْنِ الْمَنفُوشِ",24],["فَأَمَّا مَن ثَقُلَتْ مَوَازِينُهُ",16],["فَهُوَ فِي عِيشَةٍ رَّاضِيَةٍ",14],["وَأَمَّا مَنْ خَفَّتْ مَوَازِينُهُ",15],["فَأُمُّهُ هَاوِيَةٌ",9],["وَمَا أَدْرَاكَ مَا هِيَهْ",13],["نَارٌ حَامِيَةٌ",8]]