[["إِذَا الشَّمْسُ كُوِّرَتْ",12],["وَإِذَا النُّجُومُ انكَدَرَتْ",16],["وَإِذَا الْجِبَالُ سُيِّرَتْ",14],["وَإِذَا الْعِشَارُ عُطِّلَتْ",14],["وَإِذَا الْوُحُوشُ حُشِرَتْ",14],["وَإِذَا الْبِحَارُ سُجِّرَتْ",14],["وَإِذَا النُّفُوسُ زُوِّجَتْ",14],["وَإِذَا الْمَوْءُودَةُ سُئِلَتْ",15],["بِأَيِّ ذَنبٍ قُتِلَتْ",10],["وَإِذَا الصُّحُفُ نُشِرَتْ",13],["وَإِذَا السَّمَاءُ كُشِطَتْ",14],["وَإِذَا الْجَحِيمُ سُعِّرَتْ",14],["وَإِذَا الْجَنَّةُ أُزْلِفَتْ",14],["عَلِمَتْ نَفْسٌ مَّا أَحْضَرَتْ",14],["فَلَا أُقْسِمُ بِالْخُنَّسِ",13],["الْجَوَارِ الْكُنَّسِ",11],["وَاللَّيْلِ إِذَا عَسْعَسَ",12],["وَالصُّبْحِ إِذَا تَنَفَّسَ",13],["إِنَّهُ لَقَوْلُ رَسُولٍ كَرِيمٍ",15],["ذِي قُوَّةٍ عِندَ ذِي الْعَرْشِ مَكِينٍ",19],["مُّطَاعٍ ثَمَّ أَمِينٍ",10],["وَمَا صَاحِبُكُم بِمَجْنُونٍ",15],["وَلَقَدْ رَآهُ بِالْأُفُقِ الْمُبِينِ",20],["وَمَا هُوَ عَلَى الْغَيْبِ بِضَنِينٍ",18],["وَمَا هُوَ بِقَوْلِ شَيْطَانٍ رَّجِيمٍ",17],["فَأَيْنَ تَذْهَبُونَ",10],["إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَالَمِينَ",17],["لِمَن شَاءَ مِنكُمْ أَن يَسْتَقِيمَ",18],["وَمَا تَشَاءُونَ إِلَّا أَن يَشَاءَ اللَّهُ رَبُّ الْعَالَمِينَ",31]]