[["وَالْعَادِيَاتِ ضَبْحًا",11],["فَالْمُورِيَاتِ قَدْحًا",12],["فَالْمُغِيرَاتِ صُبْحًا",12],["فَأَثَرْنَ بِهِ نَقْعًا",11],["فَوَسَطْنَ بِهِ جَمْعًا",11],["إِنَّ الْإِنسَانَ لِرَبِّهِ لَكَنُودٌ",17],["وَإِنَّهُ عَلَىٰ ذَٰلِكَ لَشَهِيدٌ",15],["وَإِنَّهُ لِحُبِّ الْخَيْرِ لَشَدِيدٌ",17],["أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِي الْقُبُورِ",25],["وَحُصِّلَ مَا فِي الصُّدُورِ",14],["إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍ لَّخَبِيرٌ",19]]