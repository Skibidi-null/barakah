[["وَاللَّيْلِ إِذَا يَغْشَىٰ",12],["وَالنَّهَارِ إِذَا تَجَلَّىٰ",14],["وَمَا خَلَقَ الذَّكَرَ وَالْأُنثَىٰ",18],["إِنَّ سَعْيَكُمْ لَشَتَّىٰ",11],["فَأَمَّا مَنْ أَعْطَىٰ وَاتَّقَىٰ",15],["وَصَدَّقَ بِالْحُسْنَىٰ",11],["فَسَنُيَسِّرُهُ لِلْيُسْرَىٰ",13],["وَأَمَّا مَن بَخِلَ وَاسْتَغْنَىٰ",16],["وَكَذَّبَ بِالْحُسْنَىٰ",11],["فَسَنُيَسِّرُهُ لِلْعُسْرَىٰ",13],["وَمَا يُغْنِي عَنْهُ مَالُهُ إِذَا تَرَدَّىٰ",21],["إِنَّ عَلَيْنَا لَلْهُدَىٰ",12],["وَإِنَّ لَنَا لَلْآخِرَةَ وَالْأُولَىٰ",19],["فَأَنذَرْتُكُمْ نَارًا تَلَظَّىٰ",16],["لَا يَصْلَاهَا إِلَّا الْأَشْقَى",17],["الَّذِي كَذَّبَ وَتَوَلَّىٰ",12],["وَسَيُجَنَّبُهَا الْأَتْقَى",14],["الَّذِي يُؤْتِي مَالَهُ يَتَزَكَّىٰ",17],["وَمَا لِأَحَدٍ عِندَهُ مِن نِّعْمَةٍ تُجْزَىٰ",21],["إِلَّا ابْتِغَاءَ وَجْهِ رَبِّهِ الْأَعْلَىٰ",21],["وَلَسَوْفَ يَرْضَىٰ",9]]