[["إِذَا السَّمَاءُ انشَقَّتْ",14],["وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ",14],["وَإِذَا الْأَرْضُ مُدَّتْ",12],["وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ",16],["وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ",14],["يَا أَيُّهَا الْإِنسَانُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًا فَمُلَاقِيهِ",34],["فَأَمَّا مَنْ أُوتِيَ كِتَابَهُ بِيَمِينِهِ",20],["فَسَوْفَ يُحَاسَبُ حِسَابًا يَسِيرًا",19],["وَيَنقَلِبُ إِلَىٰ أَهْلِهِ مَسْرُورًا",19],["وَأَمَّا مَنْ أُوتِيَ كِتَابَهُ وَرَاءَ ظَهْرِهِ",22],["فَسَوْفَ يَدْعُو ثُبُورًا",14],["وَيَصْلَىٰ سَعِيرًا",10],["إِنَّهُ كَانَ فِي أَهْلِهِ مَسْرُورًا",18],["إِنَّهُ ظَنَّ أَن لَّن يَحُورَ",13],["بَلَىٰ إِنَّ رَبَّهُ كَانَ بِهِ بَصِيرًا",18],["فَلَا أُقْسِمُ بِالشَّفَقِ",13],["وَاللَّيْلِ وَمَا وَسَقَ",11],["وَالْقَمَرِ إِذَا اتَّسَقَ",13],["لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍ",15],["فَمَا لَهُمْ لَا يُؤْمِنُونَ",14],["وَإِذَا قُرِئَ عَلَيْهِمُ الْقُرْآنُ لَا يَسْجُدُونَ",27],["بَلِ الَّذِينَ كَفَرُوا يُكَذِّبُونَ",18],["وَاللَّهُ أَعْلَمُ بِمَا يُوعُونَ",17],["فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ",15],["إِلَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ",40]]