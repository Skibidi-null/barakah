[["وَالنَّازِعَاتِ غَرْقًا",11],["وَالنَّاشِطَاتِ نَشْطًا",11],["وَالسَّابِحَاتِ سَبْحًا",11],["فَالسَّابِقَاتِ سَبْقًا",11],["فَالْمُدَبِّرَاتِ أَمْرًا",12],["يَوْمَ تَرْجُفُ الرَّاجِفَةُ",14],["تَتْبَعُهَا الرَّادِفَةُ",13],["قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ",14],["أَبْصَارُهَا خَاشِعَةٌ",10],["يَقُولُونَ أَإِنَّا لَمَرْدُودُونَ فِي الْحَافِرَةِ",27],["أَإِذَا كُنَّا عِظَامًا نَّخِرَةً",15],["قَالُوا تِلْكَ إِذًا كَرَّةٌ خَاسِرَةٌ",19],["فَإِنَّمَا هِيَ زَجْرَةٌ وَاحِدَةٌ",15],["فَإِذَا هُم بِالسَّاهِرَةِ",14],["هَلْ أَتَاكَ حَدِيثُ مُوسَىٰ",14],["إِذْ نَادَاهُ رَبُّهُ بِالْوَادِ الْمُقَدَّسِ طُوًى",25],["اذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُ طَغَىٰ",18],["فَقُلْ هَل لَّكَ إِلَىٰ أَن تَزَكَّىٰ",16],["وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ",17],["فَأَرَاهُ الْآيَةَ الْكُبْرَىٰ",16],["فَكَذَّبَ وَعَصَىٰ",8],["ثُمَّ أَدْبَرَ يَسْعَىٰ",10],["فَحَشَرَ فَنَادَىٰ",9],["فَقَالَ أَنَا رَبُّكُمُ الْأَعْلَىٰ",17],["فَأَخَذَهُ اللَّهُ نَكَالَ الْآخِرَةِ وَالْأُولَىٰ",26],["إِنَّ فِي ذَٰلِكَ لَعِبْرَةً لِّمَن يَخْشَىٰ",19],["أَأَنتُمْ أَشَدُّ خَلْقًا أَمِ السَّمَاءُ ۚ بَنَاهَا",25],["رَفَعَ سَمْكَهَا فَسَوَّاهَا",14],["وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَاهَا",20],["وَالْأَرْضَ بَعْدَ ذَٰلِكَ دَحَاهَا",17],["أَخْرَجَ مِنْهَا مَاءَهَا وَمَرْعَاهَا",20],["وَالْجِبَالَ أَرْسَاهَا",13],["مَتَاعًا لَّكُمْ وَلِأَنْعَامِكُمْ",15],["فَإِذَا جَاءَتِ الطَّامَّةُ الْكُبْرَىٰ",20],["يَوْمَ يَتَذَكَّرُ الْإِنسَانُ مَا سَعَىٰ",19],["وَبُرِّزَتِ الْجَحِيمُ لِمَن يَرَىٰ",17],["فَأَمَّا مَن طَغَىٰ",9],["وَآثَرَ الْحَيَاةَ الدُّنْيَا",17],["فَإِنَّ الْجَحِيمَ هِيَ الْمَأْوَىٰ",17],["وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِ وَنَهَى النَّفْسَ عَنِ الْهَوَىٰ",32],["فَإِنَّ الْجَنَّةَ هِيَ الْمَأْوَىٰ",16],["يَسْأَلُونَكَ عَنِ السَّاعَةِ أَيَّانَ مُرْسَاهَا",24],["فِيمَ أَنتَ مِن ذِكْرَاهَا",14],["إِلَىٰ رَبِّكَ مُنتَهَاهَا",13],["إِنَّمَا أَنتَ مُنذِرُ مَن يَخْشَاهَا",19],["كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوا إِلَّا عَشِيَّةً أَوْ ضُحَاهَا",36]]