[["وَالضُّحَىٰ",6],["وَاللَّيْلِ إِذَا سَجَىٰ",11],["مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ",15],["وَلَلْآخِرَةُ خَيْرٌ لَّكَ مِنَ الْأُولَىٰ",20],["وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰ",18],["أَلَمْ يَجِدْكَ يَتِيمًا فَآوَىٰ",16],["وَوَجَدَكَ ضَالًّا فَهَدَىٰ",13],["وَوَجَدَكَ عَائِلًا فَأَغْنَىٰ",15],["فَأَمَّا الْيَتِيمَ فَلَا تَقْهَرْ",17],["وَأَمَّا السَّائِلَ فَلَا تَنْهَرْ",17],["وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ",16]]