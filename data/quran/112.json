[[1," قُلْ هُوَ ٱللَّهُ أَحَدٌ","Say, \"He is Allāh, [who is] One,","Qul huwa Allahu ahad",604,30,0],[2,"ٱللَّهُ ٱلصَّمَدُ","Allāh, the Eternal Refuge.","Allahu assamad",604,30,0],[3,"لَمْ يَلِدْ وَلَمْ يُولَدْ","He neither begets nor is born,","Lam yalid walam yoolad",604,30,0],[4,"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","Nor is there to Him any equivalent.\"","Walam yakun lahu kufuwan ahad",604,30,0]]