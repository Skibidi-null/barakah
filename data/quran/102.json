[[1," أَلْهَىٰكُمُ ٱلتَّكَاثُرُ","Competition in [worldly] increase diverts you","Alhakumu attakathur",600,30,0],[2,"حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ","Until you visit the graveyards.","Hatta zurtumu almaqabir",600,30,0],[3,"كَلَّا سَوْفَ تَعْلَمُونَ","No! You are going to know.","Kalla sawfa taAAlamoon",600,30,0],[4,"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ","Then, no! You are going to know.","Thumma kalla sawfa taAAlamoon",600,30,0],[5,"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ","No! If you only knew with knowledge of certainty...","Kalla law taAAlamoona AAilma alyaqeen",600,30,0],[6,"لَتَرَوُنَّ ٱلْجَحِيمَ","You will surely see the Hellfire.","Latarawunna aljaheem",600,30,0],[7,"ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ","Then you will surely see it with the eye of certainty.","Thumma latarawunnaha AAayna alyaqeen",600,30,0],[8,"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ","Then you will surely be asked that Day about pleasure.","Thumma latus-alunna yawma-ithin AAaniannaAAeem",600,30,0]]